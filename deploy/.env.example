# Names only. Copy to deploy/.env and fill in on the server. Never commit deploy/.env.
APP_NAME="Better NotebookLM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
# The tag of the images you loaded on the box (the short commit id they were built from)
IMAGE_TAG=
# Error monitoring (D-043): Sentry's DSN, EU region. Empty switches it off.
SENTRY_LARAVEL_DSN=
RUN_MIGRATIONS=true

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=application_test
DB_USERNAME=app
DB_PASSWORD=
POSTGRES_DB=application_test
POSTGRES_USER=app
POSTGRES_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr

# No mail service (D-022): the owner hands out invitation links himself. `php artisan invite <email> <role>` prints the link.
MAIL_MAILER=log

# Sign in with Google (the OAuth client you created; the redirect is APP_URL plus /auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AI providers: filled in by step 2
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Langfuse Cloud (EU): filled in by step 2
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production

# Cloudflare tunnel: the token of a NEW tunnel you create for this app (its hostname points at http://app:80)
CLOUDFLARE_TUNNEL_TOKEN=

# ElevenLabs (the podcast voice for reviewers and pro users): the owner creates the key
ELEVENLABS_API_KEY=
# Optional: leave empty to use the defaults (two premade voices)
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=

# Stripe, TEST MODE ONLY ("Pro (demo)": no real money). The owner creates the sandbox account and the keys. A key that is not sk_test_ stops the app at boot.
STRIPE_KEY=
STRIPE_SECRET=
# From the webhook endpoint https://<your host>/stripe/webhook (event: checkout.session.completed), or `stripe listen` in development
STRIPE_WEBHOOK_SECRET=

# Generated notebook icons (D-032), off by default. The owner creates the OpenAI key. Every failure keeps the emoji.
NOTEBOOK_ICONS=false
OPENAI_API_KEY=
# Optional: another image model (it must have a price in config/pricing.php, or the call is refused)
IMAGE_MODEL=
